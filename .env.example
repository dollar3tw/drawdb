# 服務配置
PORT=3001
NODE_ENV=production

# 安全配置
JWT_SECRET=your-jwt-secret-key-here
SESSION_SECRET=your-session-secret-key-here

# Synology SSO 配置（可選）
# 如果要啟用 SSO 登入，請填寫以下配置
SSO_ISSUER=https://sso.your-domain.com
SSO_CLIENT_ID=your-sso-client-id
SSO_CLIENT_SECRET=your-sso-client-secret
SSO_REDIRECT_URI=http://your-app-domain/sso/callback

# 資料庫配置（預設使用 SQLite）
# DATABASE_PATH=./database/drawdb.sqlite