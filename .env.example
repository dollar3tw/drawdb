# ========================================
# MiTDB 環境變數設定檔
# 請複製此檔案為 .env 並修改成您的設定
# ========================================

# ----------------
# 服務配置
# ----------------
PORT=3001
# NODE_ENV 請在啟動指令中設定，例如：NODE_ENV=production npm start

# ----------------
# API 配置
# ----------------
# 如果前後端分離，設定後端 API URL
# VITE_BACKEND_URL=http://localhost:3001

# ----------------
# 安全配置（重要：請務必修改）
# ----------------
# JWT 密鑰（用於簽署認證令牌）
JWT_SECRET=mitdb-default-jwt-secret-2024

# Session 密鑰（用於加密 session）
SESSION_SECRET=your-session-secret-key

# 狀態加密密鑰（用於 SSO 狀態加密）
STATE_SECRET=state-encryption-secret-key

# 預設管理員密碼（首次登入後必須修改）
ADMIN_DEFAULT_PASSWORD=admin

# ----------------
# Synology SSO 配置
# ----------------
# SSO 伺服器地址
SSO_ISSUER=https://sso.mi-tech.com.tw

# SSO 客戶端 ID
SSO_CLIENT_ID=36f8f572185af7c037e2045afd100f27

# SSO 客戶端密鑰
SSO_CLIENT_SECRET=SaiBDPWnoPHueoy7QcrHkgHwtfUXmLPX

# SSO 回調 URL（必須與 SSO 伺服器設定一致）
SSO_REDIRECT_URI=http://dd2.mi-tech.com.tw/sso/callback

# SSO 權限範圍
SSO_SCOPE=openid profile email

# ----------------
# 資料庫配置
# ----------------
# SQLite 資料庫路徑（預設值通常不需修改）
# DATABASE_PATH=./mitdb.sqlite

# ----------------
# Docker 部署配置
# ----------------
# 資料持久化目錄（Docker 部署時使用）
# 絕對路徑範例：
# - 個人目錄: ~/mitdb/data 或 /home/username/mitdb/data（推薦）
# - 系統目錄: /opt/mitdb/data 或 /var/lib/mitdb/data（需要 root）
# - 自定義: /data/mitdb 或任何你喜歡的路徑
# - Windows: C:/mitdb/data
# - macOS: /Users/username/mitdb/data
# 相對路徑範例：
# - ./data (專案目錄下的 data 資料夾)
DATA_PATH=~/mitdb/data

# ----------------
# 開發環境設定
# ----------------
# 忽略 SSL 證書驗證（僅開發環境使用）
# NODE_TLS_REJECT_UNAUTHORIZED=0